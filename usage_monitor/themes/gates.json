    "fixed_roles_legend": [
      "ok: LIVE lamp, Under pace",
      "warn: value and footer text, Ahead of pace",
      "alert: critical text, Nearly out",
      "usage_warn: bar 60 % to 85 %",
      "usage_alert: bar from 85 %",
      "stale: grey lamp, dimmed bars, dashed ring",
      "accent: the only colour a variant changes"
    ],
    "severity": {
      "warn_at_pct": 60,
      "alert_at_pct": 85,
      "source": "API severity when present, else these thresholds"
    },
    "pace": {
      "ahead": "usage_pct > elapsed_pct",
      "under": "usage_pct <= elapsed_pct",
      "footers": {
        "normal": "Under pace · Resets {time}",
        "warn": "Ahead of pace · Resets {time}",
        "crit": "Nearly out · Resets {time}",
        "stale": "Hmm, we lost touch. Sign in to Claude Code.",
        "offline": "No connection. Retrying every minute.",
        "paused": "Paused. Resume to keep usage live."
      }
    },
    "fable_rule": "Fable row shows only when the LIVE feed reports a Fable window with share_pct > 0 and session and weekly are both below 60 %. Otherwise the footer takes the third slot and the Fable row is dropped with it. The widget is 128 px tall in every state.",
    "rails": "time rail = elapsed_pct of the window, derived from the reset timestamp (see fixtures.rule). Index tick 1 x 6 px at the rail end.",
    "fixtures": {
      "clock_local": "2026-10-21T16:12:00",
      "session": {
        "window_h": 5,
        "normal_reset": "2026-10-21T19:39:00",
        "elapsed_pct": 31,
        "used_pct": 13,
        "warn_reset": "2026-10-21T18:12:00",
        "warn_elapsed_pct": 60,
        "warn_used_pct": 72,
        "crit_used_pct": 93
      },
      "weekly": {
        "window_h": 168,
        "reset": "2026-10-25T16:00:00",
        "elapsed_pct": 43,
        "used_pct": 2,
        "warn_used_pct": 41,
        "crit_used_pct": 52
      },
      "fable": {
        "share_pct": 50,
        "used_pct": 0,
        "reset": "2026-10-25T16:00:00"
      },
      "stale_age": "14 min",
      "offline_age": "6 min",
      "paused_age": "2 h",
      "live_age": "12 s",
      "rule": "elapsed_pct = (clock - (reset - window)) / window * 100, rounded"
    },
    "footer_widths": {
      "note": "measured by pillow_proto.py at 11 px SegUIVar (wght 400/600)",
