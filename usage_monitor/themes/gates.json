  "extras": {
    "schema_notes": "Extra keys are allowed inside extras. Colours in colors and extras are #rrggbb or #rrggbbaa. Widget metrics are integer px at 1x.",
    "mode_policy": "Light and dark are separate variants (same accent, different mode). System mode is resolved by the host from the Windows app theme (AppsUseLightTheme) and picks the dark or light entry of the chosen accent. No variant uses mode null.",
    "accent_policy": "System accent = the Windows accent colour read at runtime; the system-* values are the fallback. The other six accents are fixed pairs (accent-d for dark, accent-l for light).",
    "locked_roles": [
      "ok",
      "warn",
      "alert",
      "usage_warn",
      "usage_alert",
      "stale",
      "text_3",
