{
  "id": "gates",
  "name": "Gates",
  "tagline": "Readouts on native Fluent surfaces: a rail for time, a bar for usage, one lamp for the link.",
  "fonts": {
    "display": {
      "family": "Segoe UI Variable Display",
      "file_hint": "SegUIVar.ttf (variable). Pillow: named instance 'Semibold Display' (wght 600, opsz 28). CSS fallback 'Segoe UI Variable'.",
      "licence": "Microsoft Windows 11 system font. Not redistributable: read from C:\\Windows\\Fonts, never bundled."
    },
    "body": {
      "family": "Segoe UI Variable Text",
      "file_hint": "SegUIVar.ttf (variable). Pillow: wght 400 for labels and footers, wght 600 for titles and the pill word, opsz 11-12. CSS fallback 'Segoe UI Variable'.",
      "licence": "Microsoft Windows 11 system font. Not redistributable: read from C:\\Windows\\Fonts, never bundled."
    },
    "mono": {
      "family": "Cascadia Mono",
      "file_hint": "CascadiaMono.ttf (variable 200-700). Pillow: wght 700 for values, wght 400 for tags.",
      "licence": "SIL Open Font License 1.1 (Cascadia Code / Cascadia Mono, Microsoft)."
    }
  },
  "shape": {
    "radius": 8,
    "control_radius": 4,
    "chamfer": 0,
    "stroke": 1
  },
  "effects": {
    "glow_radius": 6,
    "glow_strength": 0.36,
    "scanlines": 0,
    "scanline_spacing": 0,
    "flicker": false,
    "vignette": 0,
    "glitch": false,
    "curvature": 0
  },
  "bar": {
    "style": "solid",
    "segments": 0,
    "gap": 0,
    "height": 4
  },
  "widget": {
    "floating": {
      "width": 288,
      "height": 128,
      "height_with_scoped": 128
    },
    "taskbar": {
      "width": 248
    }
  },
